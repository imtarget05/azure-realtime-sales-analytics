{
    "name": "SalesAnalyticsPipeline",
    "properties": {
        "description": "Pipeline ETL: Blob → SQL → SubmitMLJob → WaitForMLJob (Until) → CheckMLSuccess (If) → UpdateForecasts / FailMLJob",
        "variables": {
            "mlJobRunId": {
                "type": "String",
                "defaultValue": ""
            },
            "mlJobStatus": {
                "type": "String",
                "defaultValue": "NotStarted"
            }
        },
        "activities": [
            {
                "name": "CopyBlobToSQL",
                "type": "Copy",
                "description": "Copy dữ liệu từ Blob Storage staging vào Azure SQL",
                "inputs": [
                    {
                        "referenceName": "BlobStagingDataset",
                        "type": "DatasetReference"
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "SqlSalesDataset",
                        "type": "DatasetReference"
                    }
                ],
                "typeProperties": {
                    "source": {
                        "type": "BlobSource",
                        "recursive": true
                    },
                    "sink": {
                        "type": "SqlSink",
                        "writeBehavior": "insert",
                        "sqlWriterCleanupScript": null
                    }
                }
            },
            {
                "name": "PrepareTrainingData",
                "type": "SqlServerStoredProcedure",
                "description": "Chạy stored procedure chuẩn bị dữ liệu huấn luyện",
                "dependsOn": [
                    {
                        "activity": "CopyBlobToSQL",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "linkedServiceName": {
                    "referenceName": "AzureSqlDatabaseLS",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "storedProcedureName": "sp_PrepareTrainingData"
                }
            },
            {
                "name": "SubmitMLJob",
                "type": "WebActivity",
                "description": "Gọi Azure ML REST API để submit training job, lấy về runId",
                "dependsOn": [
                    {
                        "activity": "PrepareTrainingData",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "url": "@concat('https://management.azure.com/subscriptions/', pipeline().parameters.subscriptionId, '/resourceGroups/', pipeline().parameters.resourceGroup, '/providers/Microsoft.MachineLearningServices/workspaces/', pipeline().parameters.amlWorkspace, '/jobs?api-version=2023-04-01')",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": {
                        "properties": {
                            "jobType": "Pipeline",
                            "componentId": "@pipeline().parameters.amlPipelineId",
                            "displayName": "sales-forecast-retrain",
                            "experimentName": "sales-forecast-experiment"
                        }
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://management.azure.com/"
                    }
                }
            },
            {
                "name": "SetMLJobRunId",
                "type": "SetVariable",
                "description": "Lưu runId trả về từ SubmitMLJob vào pipeline variable",
                "dependsOn": [
                    {
                        "activity": "SubmitMLJob",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "variableName": "mlJobRunId",
                    "value": "@activity('SubmitMLJob').output.name"
                }
            },
            {
                "name": "WaitForMLJob",
                "type": "Until",
                "description": "Poll trạng thái ML job cho đến khi hoàn thành hoặc thất bại",
                "dependsOn": [
                    {
                        "activity": "SetMLJobRunId",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@or(equals(variables('mlJobStatus'), 'Completed'), equals(variables('mlJobStatus'), 'Failed'), equals(variables('mlJobStatus'), 'Canceled'))",
                        "type": "Expression"
                    },
                    "timeout": "0.04:00:00",
                    "activities": [
                        {
                            "name": "PauseActivity",
                            "type": "Wait",
                            "description": "Chờ 60 giây trước khi poll lại",
                            "typeProperties": {
                                "waitTimeInSeconds": 60
                            }
                        },
                        {
                            "name": "GetMLJobStatus",
                            "type": "WebActivity",
                            "description": "Gọi Azure ML REST API để lấy trạng thái job hiện tại",
                            "dependsOn": [
                                {
                                    "activity": "PauseActivity",
                                    "dependencyConditions": ["Succeeded"]
                                }
                            ],
                            "typeProperties": {
                                "url": "@concat('https://management.azure.com/subscriptions/', pipeline().parameters.subscriptionId, '/resourceGroups/', pipeline().parameters.resourceGroup, '/providers/Microsoft.MachineLearningServices/workspaces/', pipeline().parameters.amlWorkspace, '/jobs/', variables('mlJobRunId'), '?api-version=2023-04-01')",
                                "method": "GET",
                                "authentication": {
                                    "type": "MSI",
                                    "resource": "https://management.azure.com/"
                                }
                            }
                        },
                        {
                            "name": "SetMLJobStatus",
                            "type": "SetVariable",
                            "description": "Cập nhật biến mlJobStatus từ kết quả poll",
                            "dependsOn": [
                                {
                                    "activity": "GetMLJobStatus",
                                    "dependencyConditions": ["Succeeded"]
                                }
                            ],
                            "typeProperties": {
                                "variableName": "mlJobStatus",
                                "value": "@activity('GetMLJobStatus').output.properties.status"
                            }
                        }
                    ]
                }
            },
            {
                "name": "CheckMLSuccess",
                "type": "IfCondition",
                "description": "Kiểm tra ML job thành công hay thất bại",
                "dependsOn": [
                    {
                        "activity": "WaitForMLJob",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(variables('mlJobStatus'), 'Completed')",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "UpdateForecasts",
                            "type": "SqlServerStoredProcedure",
                            "description": "Cập nhật bảng dự đoán sau khi ML hoàn thành",
                            "linkedServiceName": {
                                "referenceName": "AzureSqlDatabaseLS",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "storedProcedureName": "sp_UpdateForecasts"
                            }
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "FailMLJob",
                            "type": "Fail",
                            "description": "Báo lỗi pipeline khi ML job không thành công",
                            "typeProperties": {
                                "message": "@concat('ML job failed with status: ', variables('mlJobStatus'), '. RunId: ', variables('mlJobRunId'))",
                                "errorCode": "ML_JOB_FAILED"
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "subscriptionId": {
                "type": "String"
            },
            "resourceGroup": {
                "type": "String"
            },
            "amlWorkspace": {
                "type": "String"
            },
            "amlPipelineId": {
                "type": "String"
            }
        }
    },
    "linkedServices": [
        {
            "name": "AzureBlobStorageLS",
            "properties": {
                "type": "AzureBlobStorage",
                "typeProperties": {
                    "connectionString": "@{linkedService().blobConnectionString}"
                }
            }
        },
        {
            "name": "AzureSqlDatabaseLS",
            "properties": {
                "type": "AzureSqlDatabase",
                "typeProperties": {
                    "connectionString": "@{linkedService().sqlConnectionString}"
                }
            }
        },
        {
            "name": "AzureMLServiceLS",
            "properties": {
                "type": "AzureMLService",
                "typeProperties": {
                    "subscriptionId": "<subscription-id>",
                    "resourceGroupName": "<resource-group>",
                    "mlWorkspaceName": "<ml-workspace-name>"
                }
            }
        }
    ],
    "datasets": [
        {
            "name": "BlobStagingDataset",
            "properties": {
                "type": "AzureBlob",
                "linkedServiceName": {
                    "referenceName": "AzureBlobStorageLS",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "folderPath": "data-factory-staging",
                    "format": {
                        "type": "JsonFormat"
                    }
                }
            }
        },
        {
            "name": "SqlSalesDataset",
            "properties": {
                "type": "AzureSqlTable",
                "linkedServiceName": {
                    "referenceName": "AzureSqlDatabaseLS",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "tableName": "dbo.SalesTransactions"
                }
            }
        }
    ],
    "triggers": [
        {
            "name": "DailyMLTrigger",
            "properties": {
                "type": "ScheduleTrigger",
                "description": "Trigger chạy pipeline ML hàng ngày lúc 02:00 UTC",
                "pipelines": [
                    {
                        "pipelineReference": {
                            "referenceName": "MLOrchestration",
                            "type": "PipelineReference"
                        }
                    }
                ],
                "typeProperties": {
                    "recurrence": {
                        "frequency": "Day",
                        "interval": 1,
                        "startTime": "2026-03-01T02:00:00Z",
                        "timeZone": "UTC",
                        "schedule": {
                            "hours": [2],
                            "minutes": [0]
                        }
                    }
                }
            }
        }
    ]
}
