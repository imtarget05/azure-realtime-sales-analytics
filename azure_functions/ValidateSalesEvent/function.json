{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "type": "eventHubTrigger",
      "name": "events",
      "direction": "in",
      "eventHubName": "%EVENT_HUB_NAME%",
      "connection": "EVENT_HUB_CONNECTION_STRING",
      "cardinality": "many",
      "consumerGroup": "$Default",
      "dataType": "string"
    },
    {
      "type": "eventHub",
      "name": "validatedEvents",
      "direction": "out",
      "eventHubName": "%VALIDATED_EVENT_HUB_NAME%",
      "connection": "VALIDATED_EVENT_HUB_CONNECTION_STRING"
    },
    {
      "type": "sql",
      "name": "invalidEvents",
      "direction": "out",
      "commandText": "dbo.ValidationLogs",
      "commandType": "StoredProcedure",
      "connectionStringSetting": "SqlConnectionString"
    }
  ]
}
